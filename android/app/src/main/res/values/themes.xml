<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. Compose handles most theming at the code
         level (MaterialTheme in Kotlin), so this just needs to exist and
         set a reasonable system-level starting point (status bar, splash
         background, etc.) before Compose takes over. -->
    <style name="Theme.NoTraceMessenger" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowBackground">#000000</item>
    </style>
</resources>
